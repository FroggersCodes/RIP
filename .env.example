# Copy to server/.env for local development.
# When using docker-compose (see docker-compose.yml) these defaults work as-is.

DATABASE_URL="postgresql://rip:rip@127.0.0.1:5432/rip?schema=public&connection_limit=20"
TEST_DATABASE_URL="postgresql://rip:rip@127.0.0.1:5432/rip_test?schema=public&connection_limit=30"
JWT_SECRET="dev-secret-change-me"
PORT=4000
ADMIN_TOKEN="dev-admin"

# Player portrait baking (server/scripts/bakePortraits.ts). Optional — the
# default "pollinations" provider needs no keys. For the free Cloudflare
# Workers AI (Flux) provider, set IMAGE_PROVIDER=cloudflare and:
#   CLOUDFLARE_ACCOUNT_ID="your-account-id"
#   CLOUDFLARE_API_TOKEN="token-with-Workers-AI-permission"
# For DALL-E / gpt-image-1: set OPENAI_API_KEY.
